+/* Py_TSTATE_EXEC_HOME: mbuf->exports is shared by every memoryview of one
+   managed buffer, and each view's registration (mbuf_add_*view) and release
+   (_memory_release, reached from memory_dealloc too) read-modify-writes it.
+   Free-threaded, those run on different OS threads at once: a view dropped by
+   a thread that does not own it is deallocated by the biased-refcount merge
+   on the thread that ALLOCATED it, while other code keeps slicing the parent.
+   A plain ++/-- then loses updates -- a lost increment releases the buffer
+   under live views ("operation forbidden on released memoryview object", and
+   the exporter is unpinned and may resize or free the memory they point at);
+   a lost decrement pins the exporter forever.  A fiber that migrates between
+   OS threads hits it on its own unshared views: each slice it drops on
+   another thread is deallocated back on the one it was created on.  In 3.15
+   every update of the per-view count (PyMemoryViewObject.exports) is already
+   FT_ATOMIC_ADD_SSIZE; this makes the per-buffer count match.
+   _Py_atomic_add_ssize returns the old value. */
+#if defined(Py_GIL_DISABLED) && defined(Py_TSTATE_EXEC_HOME)
+#  define MBUF_EXPORTS_INC(mbuf) ((void)_Py_atomic_add_ssize(&(mbuf)->exports, 1))
+#  define MBUF_EXPORTS_DEC(mbuf) (_Py_atomic_add_ssize(&(mbuf)->exports, -1) - 1)
+#  define MBUF_EXPORTS_GET(mbuf) _Py_atomic_load_ssize_relaxed(&(mbuf)->exports)
+#else
+#  define MBUF_EXPORTS_INC(mbuf) ((void)(mbuf)->exports++)
+#  define MBUF_EXPORTS_DEC(mbuf) (--(mbuf)->exports)
+#  define MBUF_EXPORTS_GET(mbuf) ((mbuf)->exports)
+#endif

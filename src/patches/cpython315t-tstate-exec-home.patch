# `grep _Py_TSTATE_FIBER_FLAG Include/internal/pycore_tstate.h`,
# `grep _Py_FIBER_PARK_HOOKS Include/cpython/object.h` and
# `grep _Py_fiber_park Python/parking_lot.c`,
# `grep BUFFERED_SELF Modules/_io/bufferedio.c` and
# `grep SEMLOCK_SELF Modules/_multiprocessing/semaphore.c`,
# `grep _PyEval_TLBCFollow Python/ceval.c` (Py_TSTATE_TLBC_FOLLOW),
# `grep _Py_FIBER_BREAKER_HOOK Include/cpython/ceval.h` and
# `grep _PyEval_RequestFiberBreak Python/ceval_gil.c`.
#
# APPLY:  from the CPython source root:  patch -p1 -F0 < this-file
# SCOPE:  Include/cpython/object.h, Include/internal/pycore_pystate.h, Python/pystate.c,
#         Include/internal/pycore_tstate.h,
#         Objects/memoryobject.c, Modules/arraymodule.c, Python/lock.c,
#         Include/internal/pycore_lock.h, Python/import.c, Python/parking_lot.c,
#         Include/internal/pycore_semaphore.h, Include/internal/pycore_parking_lot.h,
#         Modules/_threadmodule.c, Modules/_testinternalcapi/test_lock.c,
#         Modules/_io/bufferedio.c, Modules/_multiprocessing/semaphore.c,
#         Python/ceval_macros.h, Python/ceval.c (Py_TSTATE_TLBC_FOLLOW),
#         Include/cpython/ceval.h, Python/ceval_gil.c

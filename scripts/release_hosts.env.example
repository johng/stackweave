# Copy to scripts/release_hosts.env (gitignored) and fill in YOUR values.
# Used by scripts/collect_wheels.sh.
#
# STACKWEAVE_REPO_URL  leave UNSET to be prompted each run, or pin a URL.
# STACKWEAVE_REF       branch/tag/sha; default main (override inline:
#                     STACKWEAVE_REF=v0.1.0 ./scripts/collect_wheels.sh)
# RELEASE_SSH_HOSTS space-separated "<ssh-target>|<base-dir>" entries, one per
#                   non-Linux platform.  A fresh clone dir is created under
#                   <base-dir> per run and deleted on exit.  Each host needs git,
#                   a C toolchain, the CPython matrix, and cibuildwheel>=2.20.
RELEASE_SSH_HOSTS="you@your-mac|/Users/you/rl-build"
